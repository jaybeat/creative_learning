{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "e2e",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/serve-e2e.ts"
      ],
      "port": 4174
    },
    {
      "name": "preview-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vitepress",
        "preview",
        "site",
        "--port",
        "4180"
      ],
      "port": 4180
    },
    {
      "name": "course",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4190",
        "--directory",
        "docs/course"
      ],
      "port": 4190
    },
    {
      "name": "course-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4191",
        "--directory",
        "docs/course"
      ],
      "port": 4191
    }
  ]
}
