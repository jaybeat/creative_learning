{
  "name": "ds-book-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "《数据结构》书稿在线阅读站",
  "scripts": {
    "build:font": "tsx scripts/build-font.ts",
    "build:content": "tsx scripts/build-content.ts",
    "build": "npm run build:font && npm run build:content && vitepress build site",
    "dev": "tsx scripts/dev.ts",
    "preview": "vitepress preview site --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "chokidar": "^5.0.0",
    "fontkit": "^2.0.4",
    "markdown-it": "^14.3.2",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "yaml": "^2.9.1"
  }
}
